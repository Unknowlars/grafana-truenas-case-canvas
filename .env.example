# Copy to .env (never commit .env).

# --- required passwords ------------------------------------------------------------------------
FAN_GUI_PASSWORD=change-me-to-a-long-random-string
GRAFANA_PASSWORD=change-me-too

# --- optional components -----------------------------------------------------------------------
# Intel GPU exporter (Arc / integrated GPUs on the i915 or xe driver). Remove or leave empty if you have no Intel GPU.
COMPOSE_PROFILES=intel-gpu

# --- fan control -------------------------------------------------------------------------------
# 0 = monitor-only (default, nothing is written to the fans, no privileged container).
# 1 = control; only takes effect with docker-compose.control.yml (see README).
FAN_CONTROL=0
# hwmon name prefix of the chip that exposes the fans ("it8" matches IT8655E, IT8628E ...). Control supports the it87 driver only.
FAN_HWMON_PREFIX=it8

# --- ports / binding (host side) ---------------------------------------------------------------
# 0.0.0.0 = reachable from your LAN, 127.0.0.1 = this machine only. There is no HTTPS: keep it on a trusted network.
BIND_ADDR=0.0.0.0
GRAFANA_PORT=3000
FAN_GUI_PORT=18765
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100

# --- tuning ------------------------------------------------------------------------------------
PROM_RETENTION=30d
GUARD_CPU_C=65
GUARD_DRIVE_C=48
GUARD_GPU_C=85
