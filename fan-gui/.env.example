# Copy to .env (never commit .env). The app refuses to start without a password.
FAN_GUI_PASSWORD=change-me-to-a-long-random-string
FAN_GUI_USER=admin
PORT=18765

# Thermal guard: any of these returns all fans to automatic and blocks overrides.
GUARD_CPU_C=65
GUARD_DRIVE_C=48
GUARD_GPU_C=85

# intel_gpu_top data comes from your existing intel-gpu-exporter.
GPU_EXPORTER_URL=http://127.0.0.1:7071/metrics
